# Copy this file to backend/.env (git-ignored) and fill in. Restart the backend after changes.
# Any channel left blank stays in mock mode.

# --- Database: Supabase Postgres (leave SUPABASE_DB_URL blank to use in-memory mock data)
# Supabase dashboard > Connect > "Session pooler" (works on IPv4 networks; the direct host is IPv6-only).
# Its URI looks like postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Rewrite it in JDBC form, with the user and password split out:
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# --- Test safety: live messages only go to these (comma-separated emails / phone numbers)
MESSAGING_ALLOWED_RECIPIENTS=you@gmail.com
MESSAGING_ALLOW_ALL=false

# --- Email via Gmail (needs 2-Step Verification + an App Password; type it without spaces)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_IMAP_HOST=imap.gmail.com
MAIL_USERNAME=stores.yourschool@gmail.com
MAIL_PASSWORD=
# Optional: poll the inbox more often while testing (milliseconds)
MAIL_IMAP_POLL_MS=20000

# --- WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_RFQ_TEMPLATE=

# --- SMS (SMSGate Android app)
SMS_GATEWAY_SEND_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_SIGNING_KEY=
